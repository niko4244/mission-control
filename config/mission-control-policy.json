  "hard_blocks": [
    "git add .",
    "lockfile drift unless explicitly approved",
    "package drift unless explicitly approved",
    "failed validation",
    "fallback regression",
    "untracked intended test files",
    "broad unrelated route family changes",
    "client-supplied workspace ID trusted",
    "raw internal error leakage",
    "helper/auth/workspace enforcement changes without explicit approval",
    "schema/database changes without explicit approval",
    "merge without human approval"
  ],
  "protected_domains": [
    "auth",
    "workspace enforcement",
    "tokens",
    "keys",
    "gateways",
    "terminal",
    "exec",
    "approvals",
