  "risk_classes": [
    {
      "id": "Critical",
      "description": "Protected-domain, auth, security, release, execution, or schema-adjacent changes."
    },
    {
      "id": "High",
      "description": "Important runtime, release, workflow, or architecture changes with meaningful blast radius."
    },
    {
      "id": "Medium",
      "description": "Contained product or architecture work with reviewable scope."
    },
    {
      "id": "Low",
      "description": "Small localized work with low operational risk."
    },
    {
      "id": "Tooling",
      "description": "Local tooling, scripts, CI helpers, and non-runtime automation."
    },
    {
      "id": "Docs",
      "description": "Documentation-only changes with no runtime impact."
    },
    {
      "id": "TestOnly",
      "description": "Test-only changes with no production runtime mutation."
    }
  ],
